---
import Prose from "../layouts/Prose.astro";
import LinkCard from "../components/LinkCard.astro";
import { site } from "../lib/site";
import { archive, facts, texts, visuals } from "../lib/press";
---

<Prose title="Presse" description="Le kit presse de Foulée : textes prêts à reprendre, faits clés, icône et visuels à télécharger, et le contact presse.">
  <h1>Presse</h1>
  <p class="lead">Tu écris sur Foulée ? Tout ce qu'il te faut est ici : des textes à reprendre, l'icône, des visuels, et une adresse pour nous écrire.</p>

  <div class="cards">
    <LinkCard href={`/presse/${archive.name}.zip`} title="Tout le kit" detail="ZIP : icônes, visuels et textes" download />
    <LinkCard href={`mailto:${site.email}`} title="Contact presse" detail={site.email} />
    <LinkCard href={site.appStore} title="Fiche App Store" detail="Description et captures de l'app" external />
  </div>

  <h2>Faits clés</h2>
  <dl class="facts">
    {
      facts.map((fact) => (
        <div>
          <dt>{fact.term}</dt>
          <dd>{fact.detail}</dd>
        </div>
      ))
    }
  </dl>

  <h2>Textes à reprendre</h2>
  <p>Libres de reprise, tels quels ou raccourcis.</p>
  {
    texts.map((text) => (
      <section class="text">
        <h3>{text.title}</h3>
        {text.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
    ))
  }

  <h2>Icône et visuels</h2>
  <p>Merci de ne pas modifier l'icône : ni recadrage, ni changement de couleur.</p>
  <ul class="visuals">
    {
      visuals.map((visual) => (
        <li>
          <a class:list={["preview", { wide: visual.wide }]} href={`/presse/${visual.file}`} download tabindex="-1" aria-hidden="true">
            <img src={visual.preview} width={visual.wide ? 800 : 320} height={visual.wide ? 420 : 320} alt="" loading="lazy" decoding="async" />
          </a>
          <LinkCard href={`/presse/${visual.file}`} title={visual.title} detail={visual.detail} download />
        </li>
      ))
    }
  </ul>
</Prose>

<style>
  .facts {
    display: grid;
    margin: 0;
    border-top: 0.5px solid var(--hairline);
  }

  .facts div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 0.5px solid var(--hairline);
  }

  .facts dt {
    color: var(--text);
    font-weight: 600;
  }

  .facts dd {
    margin: 0;
  }

  .text {
    margin-top: 20px;
    padding: 4px 24px 8px;
    border-radius: 20px;
    background: var(--surface);
    border: 0.5px solid var(--hairline);
  }

  .text h3 {
    margin-top: 20px;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .visuals {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .visuals li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
  }

  .preview {
    display: grid;
    place-items: center;
    aspect-ratio: 40 / 21;
    border-radius: 20px;
    background: var(--surface);
    border: 0.5px solid var(--hairline);
    overflow: hidden;
  }

  .preview img {
    width: 40%;
    height: auto;
  }

  .preview.wide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .visuals {
      grid-template-columns: 1fr;
    }

    .facts div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
