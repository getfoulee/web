---
import Base from "../layouts/Base.astro";
import PhoneToday from "../components/PhoneToday.astro";
import Watches from "../components/Watches.astro";
import StoreButtons from "../components/StoreButtons.astro";
import Icon from "../components/Icon.astro";
import RouteMap from "../components/RouteMap.astro";
import ShareCard from "../components/ShareCard.astro";
import { site } from "../lib/site";

const more = [
  {
    icon: "sparkles",
    title: "Le meilleur de chaque sortie",
    text: "Un record, une allure plus rapide que d'habitude, une belle tendance : après chaque sortie, Foulée te dit ce qu'elle a de mieux face à tes six derniers mois.",
  },
  {
    icon: "bell",
    title: "Des rappels qui tombent juste",
    text: "Choisis tes jours et ton créneau. Foulée te fait signe juste avant, puis te laisse tranquille.",
  },
  {
    icon: "widgets",
    title: "Widgets et complications",
    text: "Ta série sur l'écran d'accueil, l'écran verrouillé et le cadran de ta montre.",
  },
  {
    icon: "merge",
    title: "Une sortie coupée en deux ?",
    text: "Un arrêt par erreur, une app relancée en route : réunis les deux morceaux en une seule sortie, et reviens en arrière quand tu veux.",
  },
] as const;
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal="load"><span class="dot"></span>iPhone · Apple Watch · Garmin</p>
        <h1 data-reveal="load" style="--delay:0.08s">
          <span class="line">Bouge un peu,</span>
          <span class="line gradient-text">chaque jour.</span>
        </h1>
        <p class="hero-sub" data-reveal="load" style="--delay:0.16s">
          Foulée transforme ta marche ou ta course du jour en une série que tu n'as plus envie de casser. Un rappel avant ton créneau, une sortie suivie
          jusqu'au poignet, et la journée est validée.
        </p>
        <div data-reveal="load" style="--delay:0.24s"><StoreButtons /></div>
        <p class="hero-note" data-reveal="load" style="--delay:0.3s">Gratuite · iOS {site.minimumOS} et watchOS {site.minimumOS} ou plus récents · Sans compte</p>
      </div>

      <div class="hero-visual">
        <div class="phone-wrap" data-reveal="load" style="--delay:0.15s">
          <div class="floating"><PhoneToday /></div>
        </div>
        <div class="float live theme-dark" data-reveal="load" style="--delay:0.6s" aria-hidden="true">
          <span class="live-icon"><Icon name="walk" size={16} /></span>
          <span class="live-text"><b class="numeric">18:42</b><small>Marche · 1,6 km</small></span>
          <span class="live-ring"></span>
        </div>
        <div class="float record glass" data-reveal="load" style="--delay:0.8s" aria-hidden="true">
          <Icon name="sparkles" size={16} />
          <span><b>Nouveau record</b><small>42 jours d'affilée</small></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <div class="marquee-group">
            <span>Série</span><i>✦</i><span>Marche</span><i>✦</i><span>Course</span><i>✦</i><span>Apple Watch</span><i>✦</i><span>Garmin</span><i>✦</i>
            <span>Parcours</span><i>✦</i><span>Bilan</span><i>✦</i><span>Hydratation</span><i>✦</i><span>Santé</span><i>✦</i>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Streak -->
  <section id="fonctionnalites" class="section">
    <div class="container split">
      <div class="copy" data-reveal>
        <p class="kicker">La série</p>
        <h2>Un jour, puis deux.<br />Puis tu ne t'arrêtes plus.</h2>
        <p>
          Fixe ton objectif de pas et de minutes d'activité. Remplis tes anneaux, ta série grandit, et ton record t'attend au tournant. Foulée te prévient
          juste avant ton créneau, pour que la journée ne file pas sans toi.
        </p>
      </div>
      <div class="streak-visual" data-reveal style="--delay:0.1s">
        <div class="streak-glow" aria-hidden="true"></div>
        <div class="streak-flame"><Icon name="flame" size={64} /></div>
        <p class="streak-count numeric" data-count="42" aria-label="42 jours de série">42</p>
        <p class="streak-label">jours d'affilée</p>
        <ol class="streak-days" aria-label="Les sept derniers jours, tous réussis">
          {
            ["L", "M", "M", "J", "V", "S", "D"].map((day, index) => (
              <li style={`--i:${index}`}>
                <span>
                  <Icon name="check" size={14} />
                </span>
                {day}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Walk or run -->
  <section class="section">
    <div class="container">
      <div class="center-copy" data-reveal>
        <p class="kicker">Marche ou course</p>
        <h2>Tu changes d'allure.<br /><span class="gradient-text">Foulée le remarque.</span></h2>
        <p>
          Tu pars en marchant, tu finis en courant ? Foulée reconnaît chaque portion et l'enregistre dans Santé sous le bon sport : une marche et une
          course, pas une sortie mal étiquetée. Tu n'as rien à toucher.
        </p>
      </div>

      <div class="timeline glass" data-reveal style="--delay:0.1s">
        <div class="timeline-bar" role="img" aria-label="Une sortie de 36 minutes : 10 minutes de marche, 18 minutes de course, 8 minutes de marche.">
          <span class="seg walk" style="--w:28%; --i:0"><Icon name="walk" size={18} /><b>Marche</b><small class="numeric">10 min</small></span>
          <span class="seg run" style="--w:50%; --i:1"><Icon name="run" size={18} /><b>Course</b><small class="numeric">18 min</small></span>
          <span class="seg walk" style="--w:22%; --i:2"><Icon name="walk" size={18} /><b>Marche</b><small class="numeric">8 min</small></span>
        </div>
        <p class="timeline-foot">
          <Icon name="health" size={16} class="health" />
          <span>Dans Santé : <b>2 marches</b> et <b>1 course</b>, chacune à sa place.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Watches -->
  <section id="montres" class="section">
    <div class="container split reverse">
      <div class="copy" data-reveal>
        <p class="kicker">Au poignet</p>
        <h2>Lance sur la montre.<br />Retrouve sur l'iPhone.</h2>
        <p>
          Sur l'Apple Watch, tu suis ta sortie du poignet : chrono, distance, allure, fréquence cardiaque. L'iPhone l'affiche avec son parcours, et
          l'inverse marche aussi. Pendant ce temps, une Live Activity garde l'essentiel sur l'écran verrouillé et dans la Dynamic Island.
        </p>
        <div class="garmin-card glass">
          <p class="garmin-title">Une Garmin au poignet ?</p>
          <p>
            L'app Connect IQ affiche ta série et tes compteurs du jour, met ta série sur ton cadran, lance tes marches et tes courses, et envoie tout à ton
            iPhone.
          </p>
          <a href={site.connectIQ} rel="noopener">Voir sur Connect IQ →</a>
        </div>
      </div>
      <div data-reveal style="--delay:0.1s">
        <Watches />
      </div>
    </div>
  </section>

  <!-- Route -->
  <section class="section">
    <div class="container split">
      <div class="copy" data-reveal>
        <p class="kicker">Parcours</p>
        <h2>Chaque kilomètre a sa place sur la carte.</h2>
        <p>
          Le tracé de chaque sortie, coloré selon le sport, avec un repère à chaque kilomètre et des flèches pour le sens. Sur une boucle, le départ et
          l'arrivée se rejoignent, et les flèches montrent dans quel sens tu as tourné.
        </p>
      </div>
      <div class="map glass" data-reveal style="--delay:0.1s" role="img" aria-label="Une boucle de 4,2 km : une marche dans les rues, puis une course à travers le parc et le long du fleuve, avec un repère à chaque kilomètre.">
        <RouteMap />
        <div class="map-legend">
          <span><i class="walk-dot"></i>Marche</span>
          <span><i class="run-dot"></i>Course</span>
          <span class="numeric">4,2 km · 31 min</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Bilan -->
  <section class="section">
    <div class="container split reverse">
      <div class="copy" data-reveal>
        <p class="kicker">Bilan</p>
        <h2>Ta semaine, ton mois,<br />en un coup d'œil.</h2>
        <p>
          Minutes, pas, distance, jours réussis, et l'écart avec la période d'avant. Remonte jusqu'à douze mois en arrière, puis partage ton bilan en
          image, au format carré ou story, sans rien qui dise où ni quand tu sors.
        </p>
        <p class="aside">Chaque dimanche soir et chaque 1er du mois, une notification te l'annonce.</p>
      </div>
      <div class="share-wrap" data-reveal style="--delay:0.1s">
        <ShareCard />
      </div>
    </div>
  </section>

  <!-- Hydration -->
  <section class="section">
    <div class="container">
      <div class="hydration glass" data-reveal>
        <div class="hydration-copy">
          <p class="kicker water-kicker">Hydratation</p>
          <h2>Un verre, une tape.</h2>
          <p>
            Chaque verre part dans Santé. Une tape ajoute un verre, un appui long une autre quantité. La carte d'accueil se remplit au fil de la journée et te
            dit où tu en es : dans les temps, un verre de retard, ou en avance.
          </p>
        </div>
        <div class="big-glasses" aria-hidden="true">
          {
            Array.from({ length: 8 }, (_, index) => (
              <span class:list={{ full: index < 6 }} style={`--i:${index}`}>
                <i />
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- More -->
  <section class="section">
    <div class="container">
      <div class="center-copy" data-reveal>
        <p class="kicker">Et aussi</p>
        <h2>Les petites choses qui comptent.</h2>
      </div>
      <div class="more-grid">
        {
          more.map((item, index) => (
            <article class="more-card glass" data-reveal style={`--delay:${index * 0.08}s`}>
              <span class="more-icon">
                <Icon name={item.icon} size={22} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Privacy -->
  <section class="section">
    <div class="container">
      <div class="privacy" data-reveal>
        <div class="privacy-lock" aria-hidden="true"><Icon name="lock" size={40} /></div>
        <h2>Tes données restent chez toi.</h2>
        <p class="privacy-sub">Foulée lit tes données dans Santé, sur ton iPhone, et ne les envoie nulle part.</p>
        <ul class="privacy-points">
          <li><Icon name="check" size={18} /><span><b>Aucun compte</b>Tu installes, tu sors marcher.</span></li>
          <li><Icon name="server" size={18} /><span><b>Aucun serveur à nous</b>Rien ne quitte tes appareils pour atterrir chez nous.</span></li>
          <li><Icon name="health" size={18} /><span><b>Tout passe par Santé</b>Tes sorties et tes verres d'eau restent dans l'app Santé d'Apple.</span></li>
        </ul>
        <a class="privacy-link" href="/confidentialite">Lire la politique de confidentialité →</a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section final">
    <div class="container">
      <div class="final-card theme-dark" data-reveal>
        <div class="final-glow" aria-hidden="true"></div>
        <img class="final-icon" src="/app-icon-512.png" alt="L'icône de Foulée" width="112" height="112" loading="lazy" />
        <h2>Ta prochaine foulée<br />commence aujourd'hui.</h2>
        <p>Gratuite sur l'App Store, pour iPhone et Apple Watch. Et sur Connect IQ pour ta Garmin.</p>
        <StoreButtons align="center" />
      </div>
    </div>
  </section>
</Base>

<script>
  // Count the streak up from zero the first time it scrolls into view.
  const counter = document.querySelector<HTMLElement>("[data-count]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (counter && !reduced) {
    const target = Number(counter.dataset.count);
    counter.textContent = "0";
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        const start = performance.now();
        const duration = 1600;
        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - (1 - progress) ** 3;
          counter.textContent = String(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      },
      { threshold: 0.6 },
    );
    observer.observe(counter);
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: clamp(48px, 8vw, 110px) 0 clamp(64px, 8vw, 120px);
    overflow: hidden;
  }

  .aurora {
    position: absolute;
    inset: -20% -10% 0;
    z-index: -1;
    pointer-events: none;
  }

  .aurora span {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    animation: drift 18s ease-in-out infinite alternate;
  }

  .aurora span:nth-child(1) { width: 55vw; height: 55vw; left: -10vw; top: -5vw; background: var(--blob-1); opacity: 0.8; }
  .aurora span:nth-child(2) { width: 45vw; height: 45vw; right: -8vw; top: 5vw; background: var(--blob-2); opacity: 0.55; animation-delay: -6s; }
  .aurora span:nth-child(3) { width: 40vw; height: 40vw; left: 30vw; top: 30vw; background: var(--blob-3); opacity: 0.6; animation-delay: -12s; }

  @keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(4vw, 3vw) scale(1.12); }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 48px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 24px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 0.5px solid var(--hairline);
    color: var(--text-2);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--minutes);
    animation: pulse 2.2s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgb(48 209 88 / 0.6); }
    70% { box-shadow: 0 0 0 10px rgb(48 209 88 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(48 209 88 / 0); }
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 5.6vw, 5.4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  h1 .line {
    display: block;
    white-space: nowrap;
    padding-bottom: 0.06em;
  }

  .hero-sub {
    max-width: 34ch;
    margin: 28px 0 36px;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    color: var(--text-2);
  }

  .hero-note {
    margin: 20px 0 0;
    color: var(--text-3);
    font-size: 0.9rem;
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    font-size: min(16px, 3.9vw);
  }

  .floating {
    animation: float 7s ease-in-out infinite;
  }

  @keyframes float {
    50% { translate: 0 -14px; }
  }

  .float {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    background: var(--glass);
  }

  .float b {
    display: block;
    font-size: 0.95rem;
  }

  .float small {
    display: block;
    color: var(--text-2);
    font-size: 0.75rem;
  }

  .live {
    top: 30%;
    left: -12%;
    padding: 8px 12px 8px 8px;
    border-radius: 999px;
    background: #000;
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.6);
  }

  .live-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgb(100 210 255 / 0.18);
    color: var(--walk);
  }

  .live-ring {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: conic-gradient(var(--minutes) 0 72%, rgb(255 255 255 / 0.12) 72%);
    mask: radial-gradient(circle, transparent 8px, #000 9px);
  }

  .record {
    bottom: 20%;
    right: -8%;
    color: var(--streak-start);
  }

  .record b {
    color: var(--text);
  }

  /* ---------- Marquee ---------- */
  .marquee {
    overflow: hidden;
    padding: 22px 0;
    border-block: 0.5px solid var(--hairline);
    background: rgb(255 255 255 / 0.02);
    mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-3);
    white-space: nowrap;
  }

  .marquee-group i {
    font-style: normal;
    color: var(--accent-mid);
    font-size: 0.7em;
  }

  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  /* ---------- Sections ---------- */
  .section {
    padding: clamp(72px, 11vw, 150px) 0;
  }

  h2 {
    margin: 14px 0 20px;
    font-size: clamp(2.2rem, 4.8vw, 3.9rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .copy p:not(.kicker),
  .center-copy p:not(.kicker) {
    color: var(--text-2);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
  }

  .copy {
    max-width: 520px;
  }

  .copy .aside {
    font-size: 1rem;
    color: var(--text-3);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(40px, 7vw, 96px);
  }

  .split > * {
    min-width: 0;
  }

  .split.reverse > :first-child {
    order: 2;
  }

  .center-copy {
    max-width: 760px;
    margin: 0 auto 56px;
    text-align: center;
  }

  /* ---------- Streak ---------- */
  .streak-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px 0;
    text-align: center;
  }

  .streak-glow {
    position: absolute;
    inset: 10% 15%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 107 0 / 0.35), transparent 65%);
    filter: blur(30px);
  }

  .streak-flame {
    color: var(--streak-start);
    filter: drop-shadow(0 0 24px rgb(255 107 0 / 0.6));
    animation: flicker 2.6s ease-in-out infinite;
  }

  @keyframes flicker {
    50% { transform: scale(1.06) rotate(-2deg); }
  }

  .streak-count {
    margin: 0;
    font-size: clamp(7rem, 18vw, 13rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
    background: var(--streak-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .streak-label {
    margin: 6px 0 28px;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-2);
  }

  .streak-days {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .streak-days li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-3);
  }

  .streak-days span {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--streak-gradient);
    color: white;
    box-shadow: 0 4px 14px rgb(255 107 0 / 0.35);
  }

  .js .streak-visual .streak-days span {
    transform: scale(0);
    transition: transform 0.5s cubic-bezier(0.3, 1.6, 0.5, 1);
    transition-delay: calc(0.5s + var(--i) * 0.09s);
  }

  .js .streak-visual.is-visible .streak-days span {
    transform: scale(1);
  }

  /* ---------- Walk / run timeline ---------- */
  .timeline {
    max-width: 920px;
    margin: 0 auto;
    padding: clamp(18px, 3vw, 32px);
  }

  .timeline-bar {
    display: flex;
    gap: 8px;
    height: clamp(96px, 14vw, 140px);
  }

  .seg {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2px;
    flex: 0 0 calc(var(--w) - 6px);
    min-width: 0;
    padding: 14px 16px;
    border-radius: 20px;
    overflow: hidden;
    color: #000;
  }

  .seg.walk { background: linear-gradient(160deg, #8fe0ff, var(--walk) 60%, #2fb7e8); }
  .seg.run { background: linear-gradient(160deg, #ffc15a, var(--run) 55%, #ff6b00); }

  .seg b {
    font-size: clamp(0.9rem, 1.6vw, 1.15rem);
  }

  .seg small {
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.7;
  }

  .seg :global(svg) {
    position: absolute;
    top: 14px;
    left: 14px;
  }

  .js .timeline .seg {
    clip-path: inset(0 100% 0 0 round 20px);
    transition: clip-path 0.9s cubic-bezier(0.6, 0, 0.2, 1);
    transition-delay: calc(0.3s + var(--i) * 0.45s);
  }

  .js .timeline.is-visible .seg {
    clip-path: inset(0 0 0 0 round 20px);
