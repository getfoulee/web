---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import { ANALYTICS } from "astro:env/server";
import { site } from "../lib/site";
import { organization } from "../lib/structured-data";
import { alternates, locales, pageLocale, servedPath } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  /** The Universal Link this page stands in for: the Smart App Banner's « Ouvrir » goes to the same screen. */
  appArgument?: string;
}

const locale = pageLocale(Astro.currentLocale);
const { title, description = locales[locale].description, appArgument } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${locales[locale].tagline}`;
const path = servedPath(Astro.url.pathname);
const canonical = new URL(path, site.url).href;
// The same page in the other language, when it is published in both.
const translated = alternates(path);
// The page's share card, drawn at build by src/integrations/share-images.ts.
const ogImage = new URL(`/partage${path === "/" ? "/accueil" : path}.png`, site.url).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      translated.map((alternate) => (
        <link rel="alternate" hreflang={alternate.locale} href={new URL(alternate.path, site.url).href} />
      ))
    }
    {translated.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(translated[0].path, site.url).href} />}
    <meta name="theme-color" content="#fbf7ff" media="(prefers-color-scheme: light)" data-scheme="light" />
    <meta name="theme-color" content="#07040e" media="(prefers-color-scheme: dark)" data-scheme="dark" />

    <meta name="apple-itunes-app" content={`app-id=${site.appStoreId}${appArgument ? `, app-argument=${appArgument}` : ""}`} />

    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locales[locale].og} />
    {
      translated
        .filter((alternate) => alternate.locale !== locale)
        .map((alternate) => <meta property="og:locale:alternate" content={locales[alternate.locale].og} />)
    }
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? site.tagline} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Before the first paint: mark JavaScript as on, and apply the theme the
      // visitor picked, if any. Without one, the CSS follows the device.
      const root = document.documentElement;
      root.classList.add("js");
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") root.dataset.theme = theme;
      } catch {}

      // The browser's bar colour follows the same theme: a picked theme turns
      // its meta on and the other off, no pick gives the device back the choice.
      const metas = document.querySelectorAll('meta[name="theme-color"]');
      const syncThemeColor = () => {
        const theme = root.dataset.theme;
        for (const meta of metas) {
          const scheme = meta.dataset.scheme;
          meta.media = theme ? (scheme === theme ? "all" : "not all") : `(prefers-color-scheme: ${scheme})`;
        }
      };
      syncThemeColor();
      new MutationObserver(syncThemeColor).observe(root, { attributeFilter: ["data-theme"] });
    </script>
    <JsonLd data={organization} />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal sections as they scroll into view, once.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.15 },
      );
      for (const element of document.querySelectorAll("[data-reveal]:not([data-reveal=load])")) observer.observe(element);
    </script>
    {
      ANALYTICS && (
        <script is:inline type="module" src={site.analytics.beacon} data-cf-beacon={JSON.stringify({ token: site.analytics.token })} />
      )
    }
  </body>
</html>
