---
import Base from "../layouts/Base.astro";
import PhoneToday from "./PhoneToday.astro";
import Watches from "./Watches.astro";
import StoreButtons from "./StoreButtons.astro";
import Icon from "./Icon.astro";
import JsonLd from "./JsonLd.astro";
import RouteMap from "./RouteMap.astro";
import ShareCard from "./ShareCard.astro";
import { site } from "../lib/site";
import { mobileApplication } from "../lib/structured-data";
import { screenshots } from "../lib/screenshots";
import { latest } from "../lib/releases";
import { localePath, locales, pageLocale } from "../lib/i18n";

/* The home page in each language, served at / and /en. Headings keep their
   line breaks and highlights as HTML. The English page links to the French
   pages that are not translated yet, and leaves out what only exists in
   French: the release notes and the App Store screenshots. */
const locale = pageLocale(Astro.currentLocale);
const { anchors, description, appStore } = locales[locale];

const copy = {
  fr: {
    title: ["Bouge un peu,", "chaque jour."],
    sub: "Foulée transforme ta marche ou ta course du jour en une série que tu n'as plus envie de casser. Un rappel avant ton créneau, une sortie suivie jusqu'au poignet, et la journée est validée.",
    note: `Gratuite · iOS ${site.minimumOS} et watchOS ${site.minimumOS} ou plus récents · Sans compte`,
    news: "Nouveau",
    live: "Marche · 1,6 km",
    record: ["Nouveau record", "42 jours d'affilée"],
    marquee: ["Série", "Marche", "Course", "Apple Watch", "Garmin", "Parcours", "Bilan", "Hydratation", "Santé"],
    streak: {
      kicker: "La série",
      title: "Un jour, puis deux.<br />Puis tu ne t'arrêtes plus.",
      text: "Fixe ton objectif de pas et de minutes d'activité. Remplis tes anneaux, ta série grandit, et ton record t'attend au tournant. Foulée te prévient juste avant ton créneau, pour que la journée ne file pas sans toi.",
      count: "42 jours de série",
      label: "jours d'affilée",
      week: "Les sept derniers jours, tous réussis",
      days: ["L", "M", "M", "J", "V", "S", "D"],
    },
    sport: {
      kicker: "Marche ou course",
      title: `Tu changes d'allure.<br /><span class="gradient-text">Foulée le remarque.</span>`,
      text: "Tu pars en marchant, tu finis en courant ? Foulée reconnaît chaque portion et l'enregistre dans Santé sous le bon sport : une marche et une course, pas une sortie mal étiquetée. Tu n'as rien à toucher.",
      timeline: "Une sortie de 36 minutes : 10 minutes de marche, 18 minutes de course, 8 minutes de marche.",
      walk: "Marche",
      run: "Course",
      health: "Dans Santé : <b>2 marches</b> et <b>1 course</b>, chacune à sa place.",
    },
    watches: {
      kicker: "Au poignet",
      title: "Lance sur la montre.<br />Retrouve sur l'iPhone.",
      text: "Sur l'Apple Watch, tu suis ta sortie du poignet : chrono, distance, allure, fréquence cardiaque. L'iPhone l'affiche avec son parcours, et l'inverse marche aussi. Pendant ce temps, une Live Activity garde l'essentiel sur l'écran verrouillé et dans la Dynamic Island.",
      appleWatch: "Foulée sur Apple Watch →",
      garminTitle: "Une Garmin au poignet ?",
      garmin: "L'app Connect IQ affiche ta série et tes compteurs du jour, met ta série sur ton cadran, lance tes marches et tes courses, et envoie tout à ton iPhone.",
      garminPage: "Foulée sur Garmin →",
      connectIQ: "Voir sur Connect IQ →",
    },
    route: {
      kicker: "Parcours",
      title: "Chaque kilomètre a sa place sur la carte.",
      text: "Le tracé de chaque sortie, coloré selon le sport, avec un repère à chaque kilomètre et des flèches pour le sens. Sur une boucle, le départ et l'arrivée se rejoignent, et les flèches montrent dans quel sens tu as tourné.",
      map: "Une boucle de 4,2 km : une marche dans les rues, puis une course à travers le parc et le long du fleuve, avec un repère à chaque kilomètre.",
      total: "4,2 km · 31 min",
    },
    recap: {
      kicker: "Bilan",
      title: "Ta semaine, ton mois,<br />en un coup d'œil.",
      text: "Minutes, pas, distance, jours réussis, et l'écart avec la période d'avant. Remonte jusqu'à douze mois en arrière, puis partage ton bilan en image, au format carré ou story, sans rien qui dise où ni quand tu sors.",
      aside: "Chaque dimanche soir et chaque 1er du mois, une notification te l'annonce.",
    },
    hydration: {
      kicker: "Hydratation",
      title: "Un verre, une tape.",
      text: "Chaque verre part dans Santé. Une tape ajoute un verre, un appui long une autre quantité. La carte d'accueil se remplit au fil de la journée et te dit où tu en es : dans les temps, un verre de retard, ou en avance.",
    },
    more: {
      kicker: "Et aussi",
      title: "Les petites choses qui comptent.",
      items: [
        [
          "Le meilleur de chaque sortie",
          "Un record, une allure plus rapide que d'habitude, une belle tendance : après chaque sortie, Foulée te dit ce qu'elle a de mieux face à tes six derniers mois.",
        ],
        ["Des rappels qui tombent juste", "Choisis tes jours et ton créneau. Foulée te fait signe juste avant, puis te laisse tranquille."],
        ["Widgets et complications", "Ta série sur l'écran d'accueil, l'écran verrouillé et le cadran de ta montre."],
        [
          "Une sortie coupée en deux ?",
          "Un arrêt par erreur, une app relancée en route : réunis les deux morceaux en une seule sortie, et reviens en arrière quand tu veux.",
        ],
      ],
    },
    shots: {
      kicker: "Captures",
      title: "La vraie app,<br />écran par écran.",
      text: "Les captures de la fiche App Store, telles que tu les verras avant d'installer.",
      label: "Captures de l'app, à faire défiler",
    },
    privacy: {
      title: "Tes données restent chez toi.",
      text: "Foulée lit tes données dans Santé, sur ton iPhone, et ne les envoie nulle part.",
      points: [
        ["Aucun compte", "Tu installes, tu sors marcher."],
        ["Aucun serveur à nous", "Rien ne quitte tes appareils pour atterrir chez nous."],
        ["Tout passe par Santé", "Tes sorties et tes verres d'eau restent dans l'app Santé d'Apple."],
      ],
      link: "Lire la politique de confidentialité →",
    },
    final: {
      icon: "L'icône de Foulée",
      title: "Ta prochaine foulée<br />commence aujourd'hui.",
      text: "Gratuite sur l'App Store, pour iPhone et Apple Watch. Et sur Connect IQ pour ta Garmin.",
    },
  },
  en: {
    title: ["Move a little,", "every day."],
    sub: "Foulée turns today's walk or run into a streak you won't want to break. A reminder before your time slot, a workout tracked right to your wrist, and the day is done.",
    note: `Free · iOS ${site.minimumOS} and watchOS ${site.minimumOS} or later · No account`,
    news: undefined,
    live: "Walk · 1.6 km",
    record: ["New record", "42 days in a row"],
    marquee: ["Streak", "Walk", "Run", "Apple Watch", "Garmin", "Route", "Recap", "Hydration", "Health"],
    streak: {
      kicker: "The streak",
      title: "One day, then two.<br />Then you don't stop.",
      text: "Set your goals for steps and active minutes. Close your rings, your streak grows, and your record is waiting for you. Foulée nudges you just before your time slot, so the day doesn't slip by without you.",
      count: "42-day streak",
      label: "days in a row",
      week: "The last seven days, all completed",
      days: ["M", "T", "W", "T", "F", "S", "S"],
    },
    sport: {
      kicker: "Walk or run",
      title: `You change pace.<br /><span class="gradient-text">Foulée notices.</span>`,
      text: "Start walking, finish running? Foulée recognizes each stretch and saves it in Apple Health under the right sport: a walk and a run, not one mislabeled workout. Nothing to tap.",
      timeline: "A 36-minute workout: 10 minutes of walking, 18 minutes of running, 8 minutes of walking.",
      walk: "Walk",
      run: "Run",
      health: "In Health: <b>2 walks</b> and <b>1 run</b>, each in its place.",
    },
    watches: {
      kicker: "On your wrist",
      title: "Start on the watch.<br />Find it on the iPhone.",
      text: "On Apple Watch, you follow your workout from your wrist: time, distance, pace, heart rate. The iPhone shows it with its route, and the other way round works too. Meanwhile, a Live Activity keeps the essentials on the Lock Screen and in the Dynamic Island.",
      appleWatch: "Foulée on Apple Watch →",
      garminTitle: "Got a Garmin?",
      garmin: "The Connect IQ app shows your streak and today's counters, puts your streak on your watch face, starts your walks and runs, and sends everything to your iPhone.",
      garminPage: "Foulée on Garmin →",
      connectIQ: "See it on Connect IQ →",
    },
    route: {
      kicker: "Route",
      title: "Every kilometer has its place on the map.",
      text: "The route of every workout, colored by sport, with a marker at each kilometer and arrows for the direction. On a loop, start and finish meet, and the arrows show which way you went around.",
      map: "A 4.2 km loop: a walk through the streets, then a run across the park and along the river, with a marker at each kilometer.",
      total: "4.2 km · 31 min",
    },
    recap: {
      kicker: "Recap",
      title: "Your week, your month,<br />at a glance.",
      text: "Minutes, steps, distance, days completed, and how they compare with the period before. Go back up to twelve months, then share your recap as an image, square or story, with nothing that says where or when you go out.",
      aside: "Every Sunday evening and on the 1st of each month, a notification lets you know.",
    },
    hydration: {
      kicker: "Hydration",
      title: "One glass, one tap.",
      text: "Every glass goes to Apple Health. A tap adds a glass, a long press another amount. The home card fills up through the day and tells you where you stand: on track, a glass behind, or ahead.",
    },
    more: {
      kicker: "And also",
      title: "The little things that matter.",
      items: [
        [
          "The best of every workout",
          "A record, a faster pace than usual, a good trend: after each workout, Foulée tells you what stood out against your last six months.",
        ],
        ["Reminders that land right", "Pick your days and your time slot. Foulée gives you a nudge just before, then leaves you alone."],
        ["Widgets and complications", "Your streak on the Home Screen, the Lock Screen and your watch face."],
        [
          "A workout cut in two?",
          "Stopped by mistake, the app restarted on the way: merge the two pieces into one workout, and undo it whenever you like.",
        ],
      ],
    },
    shots: undefined,
    privacy: {
      title: "Your data stays with you.",
      text: "Foulée reads your data in Apple Health, on your iPhone, and sends it nowhere.",
      points: [
        ["No account", "Install it, go for a walk."],
        ["No server of ours", "Nothing leaves your devices to land with us."],
        ["Everything goes through Health", "Your workouts and glasses of water stay in Apple's Health app."],
      ],
      link: "Read the privacy policy →",
    },
    final: {
      icon: "Foulée's icon",
      title: "Your next stride<br />starts today.",
      text: "Free on the App Store, for iPhone and Apple Watch. And on Connect IQ for your Garmin.",
    },
  },
}[locale];

const moreIcons = ["sparkles", "bell", "widgets", "merge"] as const;
const privacyIcons = ["check", "server", "health"] as const;
---

<Base>
  <JsonLd slot="head" data={{ ...mobileApplication, description, installUrl: appStore }} />
  <!-- Hero -->
  <section class="hero">
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal="load"><span class="dot"></span>iPhone · Apple Watch · Garmin</p>
        <h1 data-reveal="load" style="--delay:0.08s">
          <span class="line">{copy.title[0]}</span>
          <span class="line gradient-text">{copy.title[1]}</span>
        </h1>
        <p class="hero-sub" data-reveal="load" style="--delay:0.16s">{copy.sub}</p>
        <div data-reveal="load" style="--delay:0.24s"><StoreButtons /></div>
        <p class="hero-note" data-reveal="load" style="--delay:0.3s">{copy.note}</p>
        {
          latest && copy.news && (
            <a class="eyebrow news" href="/nouveautes" data-reveal="load" style="--delay:0.36s">
              <span class="news-tag">{copy.news}</span>
              <span>
                Foulée {latest.version} · {latest.highlights[0].title.replace(/\.$/, "")}
              </span>
            </a>
          )
        }
      </div>

      <div class="hero-visual">
        <div class="phone-wrap" data-reveal="load" style="--delay:0.15s">
          <div class="floating"><PhoneToday /></div>
        </div>
        <div class="float live theme-dark" data-reveal="load" style="--delay:0.6s" aria-hidden="true">
          <span class="live-icon"><Icon name="walk" size={16} /></span>
          <span class="live-text"><b class="numeric">18:42</b><small>{copy.live}</small></span>
          <span class="live-ring"></span>
        </div>
        <div class="float record glass" data-reveal="load" style="--delay:0.8s" aria-hidden="true">
          <Icon name="sparkles" size={16} />
          <span><b>{copy.record[0]}</b><small>{copy.record[1]}</small></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <div class="marquee-group">
            {copy.marquee.map((word) => <><span>{word}</span><i>✦</i></>)}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Streak -->
  <section id={anchors.features} class="section">
    <div class="container split">
      <div class="copy" data-reveal>
        <p class="kicker">{copy.streak.kicker}</p>
        <h2 set:html={copy.streak.title} />
        <p>{copy.streak.text}</p>
      </div>
      <div class="streak-visual" data-reveal style="--delay:0.1s">
        <div class="streak-glow" aria-hidden="true"></div>
        <div class="streak-flame"><Icon name="flame" size={64} /></div>
        <p class="streak-count numeric" data-count="42" aria-label={copy.streak.count}>42</p>
        <p class="streak-label">{copy.streak.label}</p>
        <ol class="streak-days" aria-label={copy.streak.week}>
          {
            copy.streak.days.map((day, index) => (
              <li style={`--i:${index}`}>
                <span>
                  <Icon name="check" size={14} />
                </span>
                {day}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Walk or run -->
  <section class="section">
    <div class="container">
      <div class="center-copy" data-reveal>
        <p class="kicker">{copy.sport.kicker}</p>
        <h2 set:html={copy.sport.title} />
        <p>{copy.sport.text}</p>
      </div>

      <div class="timeline glass" data-reveal style="--delay:0.1s">
        <div class="timeline-bar" role="img" aria-label={copy.sport.timeline}>
          <span class="seg walk" style="--w:28%; --i:0"><Icon name="walk" size={18} /><b>{copy.sport.walk}</b><small class="numeric">10 min</small></span>
          <span class="seg run" style="--w:50%; --i:1"><Icon name="run" size={18} /><b>{copy.sport.run}</b><small class="numeric">18 min</small></span>
          <span class="seg walk" style="--w:22%; --i:2"><Icon name="walk" size={18} /><b>{copy.sport.walk}</b><small class="numeric">8 min</small></span>
        </div>
        <p class="timeline-foot">
          <Icon name="health" size={16} class="health" />
          <span set:html={copy.sport.health} />
        </p>
      </div>
    </div>
  </section>

  <!-- Watches -->
  <section id={anchors.watches} class="section">
    <div class="container split reverse">
      <div class="copy" data-reveal>
        <p class="kicker">{copy.watches.kicker}</p>
        <h2 set:html={copy.watches.title} />
        <p>{copy.watches.text}</p>
        <a class="read-more" href={localePath("/apple-watch", locale)}>{copy.watches.appleWatch}</a>
        <div class="garmin-card glass">
          <p class="garmin-title">{copy.watches.garminTitle}</p>
          <p>{copy.watches.garmin}</p>
          <div class="more-links">
            <a class="read-more" href={localePath("/garmin", locale)}>{copy.watches.garminPage}</a>
            <a class="read-more" href={site.connectIQ} rel="noopener">{copy.watches.connectIQ}</a>
          </div>
        </div>
      </div>
      <div data-reveal style="--delay:0.1s">
        <Watches />
      </div>
    </div>
  </section>

  <!-- Route -->
  <section class="section">
    <div class="container split">
      <div class="copy" data-reveal>
        <p class="kicker">{copy.route.kicker}</p>
        <h2>{copy.route.title}</h2>
        <p>{copy.route.text}</p>
      </div>
      <div class="map glass" data-reveal style="--delay:0.1s" role="img" aria-label={copy.route.map}>
        <RouteMap />
        <div class="map-legend">
          <span><i class="walk-dot"></i>{copy.sport.walk}</span>
          <span><i class="run-dot"></i>{copy.sport.run}</span>
          <span class="numeric">{copy.route.total}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Bilan -->
  <section class="section">
    <div class="container split reverse">
      <div class="copy" data-reveal>
        <p class="kicker">{copy.recap.kicker}</p>
        <h2 set:html={copy.recap.title} />
        <p>{copy.recap.text}</p>
        <p class="aside">{copy.recap.aside}</p>
      </div>
      <div class="share-wrap" data-reveal style="--delay:0.1s">
        <ShareCard />
      </div>
    </div>
  </section>

  <!-- Hydration -->
  <section class="section">
    <div class="container">
      <div class="hydration glass" data-reveal>
        <div class="hydration-copy">
          <p class="kicker water-kicker">{copy.hydration.kicker}</p>
          <h2>{copy.hydration.title}</h2>
          <p>{copy.hydration.text}</p>
        </div>
        <div class="big-glasses" aria-hidden="true">
          {
            Array.from({ length: 8 }, (_, index) => (
              <span class:list={{ full: index < 6 }} style={`--i:${index}`}>
                <i />
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- More -->
  <section class="section">
    <div class="container">
      <div class="center-copy" data-reveal>
        <p class="kicker">{copy.more.kicker}</p>
        <h2>{copy.more.title}</h2>
      </div>
      <div class="more-grid">
        {
          copy.more.items.map(([title, text], index) => (
            <article class="more-card glass" data-reveal style={`--delay:${index * 0.08}s`}>
              <span class="more-icon">
                <Icon name={moreIcons[index]} size={22} />
              </span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Screenshots -->
  {
    copy.shots && (
      <section class="section">
        <div class="container">
          <div class="center-copy" data-reveal>
            <p class="kicker">{copy.shots.kicker}</p>
            <h2 set:html={copy.shots.title} />
            <p>{copy.shots.text}</p>
          </div>
          <ul class="shots" tabindex="0" aria-label={copy.shots.label} data-reveal style="--delay:0.1s">
            {screenshots.map((shot) => (
              <li>
                <img
                  src={`/captures/${shot.name}-300.webp`}
                  srcset={`/captures/${shot.name}-300.webp 300w, /captures/${shot.name}-600.webp 600w`}
                  sizes="(max-width: 560px) 200px, 240px"
                  width="300"
                  height="652"
                  alt={shot.alt}
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Privacy -->
  <section class="section">
    <div class="container">
      <div class="privacy" data-reveal>
        <div class="privacy-lock" aria-hidden="true"><Icon name="lock" size={40} /></div>
        <h2>{copy.privacy.title}</h2>
        <p class="privacy-sub">{copy.privacy.text}</p>
        <ul class="privacy-points">
          {
            copy.privacy.points.map(([title, text], index) => (
              <li>
                <Icon name={privacyIcons[index]} size={18} />
                <span><b>{title}</b>{text}</span>
              </li>
            ))
          }
        </ul>
        <a class="read-more" href={localePath("/confidentialite", locale)}>{copy.privacy.link}</a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section final">
    <div class="container">
      <div class="final-card theme-dark" data-reveal>
        <div class="final-glow" aria-hidden="true"></div>
        <img class="final-icon" src="/app-icon-512.png" alt={copy.final.icon} width="112" height="112" loading="lazy" />
        <h2 set:html={copy.final.title} />
        <p>{copy.final.text}</p>
        <StoreButtons align="center" />
      </div>
    </div>
  </section>
</Base>

<script>
  // Count the streak up from zero the first time it scrolls into view.
  const counter = document.querySelector<HTMLElement>("[data-count]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (counter && !reduced) {
    const target = Number(counter.dataset.count);
    counter.textContent = "0";
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        const start = performance.now();
        const duration = 1600;
        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - (1 - progress) ** 3;
          counter.textContent = String(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      },
      { threshold: 0.6 },
    );
    observer.observe(counter);
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: clamp(48px, 8vw, 110px) 0 clamp(64px, 8vw, 120px);
    overflow: hidden;
  }

  .aurora {
    position: absolute;
    inset: -20% -10% 0;
    z-index: -1;
    pointer-events: none;
  }

  .aurora span {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    animation: drift 18s ease-in-out infinite alternate;
  }

  .aurora span:nth-child(1) { width: 55vw; height: 55vw; left: -10vw; top: -5vw; background: var(--blob-1); opacity: 0.8; }
  .aurora span:nth-child(2) { width: 45vw; height: 45vw; right: -8vw; top: 5vw; background: var(--blob-2); opacity: 0.55; animation-delay: -6s; }
  .aurora span:nth-child(3) { width: 40vw; height: 40vw; left: 30vw; top: 30vw; background: var(--blob-3); opacity: 0.6; animation-delay: -12s; }

  @keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(4vw, 3vw) scale(1.12); }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 48px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 24px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 0.5px solid var(--hairline);
    color: var(--text-2);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .dot {
