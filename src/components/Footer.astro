---
import { site } from "../lib/site";
import { localePath, locales, pageLocale } from "../lib/i18n";

const year = new Date().getFullYear();
const locale = pageLocale(Astro.currentLocale);
const { home, tagline, appStore } = locales[locale];
// The English home links to the French pages that are not translated yet.
const copy = {
  fr: {
    made: "Conçue et développée en France.",
    app: "L'app",
    appleWatch: "Sur Apple Watch",
    garmin: "Sur Garmin",
    news: "Nouveautés",
    source: "Code source",
    press: "Presse",
    help: "Aide",
    support: "Assistance",
    bug: "Signaler un bug",
    legalNav: "Informations légales",
    legal: "Légal",
    privacy: "Confidentialité",
    notice: "Mentions légales",
    trademarks: "Apple, Apple Watch, iPhone et App Store sont des marques d'Apple Inc. Garmin et Connect IQ sont des marques de Garmin Ltd.",
  },
  en: {
    made: "Designed and built in France.",
    app: "The app",
    appleWatch: "On Apple Watch",
    garmin: "On Garmin",
    news: "What's new",
    source: "Source code",
    press: "Press",
    help: "Help",
    support: "Support",
    bug: "Report a bug",
    legalNav: "Legal information",
    legal: "Legal",
    privacy: "Privacy",
    notice: "Legal notice",
    trademarks: "Apple, Apple Watch, iPhone and App Store are trademarks of Apple Inc. Garmin and Connect IQ are trademarks of Garmin Ltd.",
  },
}[locale];
---

<footer class="footer">
  <div class="container grid">
    <div class="about">
      <a class="brand" href={home}>
        <img src="/app-icon-128.png" alt="" width="36" height="36" />
        <span>Foulée</span>
      </a>
      <p>{tagline}</p>
      <p class="made">{copy.made}</p>
    </div>

    <nav aria-label={copy.app}>
      <h2>{copy.app}</h2>
      <a href={appStore} rel="noopener">App Store</a>
      <a href={site.connectIQ} rel="noopener">Garmin Connect IQ</a>
      <a href="/apple-watch">{copy.appleWatch}</a>
      <a href="/garmin">{copy.garmin}</a>
      <a href="/nouveautes">{copy.news}</a>
      <a href={site.repository} rel="noopener">{copy.source}</a>
      <a href="/presse">{copy.press}</a>
    </nav>

    <nav aria-label={copy.help}>
      <h2>{copy.help}</h2>
      <a href={localePath("/assistance", locale)}>{copy.support}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.issues} rel="noopener">{copy.bug}</a>
    </nav>

    <nav aria-label={copy.legalNav}>
      <h2>{copy.legal}</h2>
      <a href={localePath("/confidentialite", locale)}>{copy.privacy}</a>
      <a href={localePath("/mentions-legales", locale)}>{copy.notice}</a>
    </nav>
  </div>

  <div class="container fineprint">
    <p>© {year} Foulée. {copy.trademarks}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 40px;
    padding: 64px 0 calc(32px + env(safe-area-inset-bottom));
    border-top: 0.5px solid var(--hairline);
    background: linear-gradient(to bottom, transparent, var(--footer-tint));
  }

  .grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 40px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.2rem;
    text-decoration: none;
  }

  .brand img {
    border-radius: 9px;
  }

  .about p {
    margin: 12px 0 0;
    color: var(--text-2);
  }

  .about .made {
    color: var(--text-3);
    font-size: 0.9rem;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  h2 {
    margin: 0 0 4px;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  nav a {
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  nav a:hover {
    color: var(--text);
  }

  .fineprint {
    margin-top: 48px;
    color: var(--text-3);
    font-size: 0.8rem;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .about {
      grid-column: 1 / -1;
    }
  }
</style>
