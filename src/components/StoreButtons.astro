---
import { site } from "../lib/site";

interface Props {
  align?: "start" | "center";
}

const { align = "start" } = Astro.props;
---

<div class:list={["buttons", align]}>
  <a class="store apple" href={site.appStore} rel="noopener">
    <svg viewBox="0 0 384 512" width="22" height="26" aria-hidden="true">
      <path
        fill="currentColor"
        d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"
      ></path>
    </svg>
    <span><small>Télécharger dans</small>l'App Store</span>
  </a>
  <a class="store garmin" href={site.connectIQ} rel="noopener">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    <span><small>Pour montre Garmin</small>Connect IQ</span>
  </a>
</div>

<style>
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .center {
    justify-content: center;
  }

  .store {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 58px;
    padding: 10px 22px 10px 18px;
    border-radius: 16px;
    text-decoration: none;
    transition:
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.25s,
      background 0.25s;
  }

  .store span {
    display: flex;
    flex-direction: column;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .store small {
    font-size: 0.72rem;
    font-weight: 500;
    opacity: 0.75;
    letter-spacing: 0;
  }

  .apple {
    background: var(--text);
    color: var(--bg);
    box-shadow: 0 10px 30px rgb(191 90 242 / 0.35);
  }

  .apple:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px rgb(191 90 242 / 0.5);
  }

  .garmin {
    background: var(--surface);
    border: 0.5px solid var(--hairline);
    color: var(--text);
  }

  .garmin:hover {
    transform: translateY(-2px);
    background: var(--surface-2);
  }
</style>
