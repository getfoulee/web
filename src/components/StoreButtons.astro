---
import { site } from "../lib/site";

interface Props {
  align?: "start" | "center";
}

const { align = "start" } = Astro.props;

// The official badges, untouched. Apple asks for its black badge, placed first,
// whenever another store's badge sits next to it, and forbids animating it;
// Garmin's black badge matches it. Neither has a theme variant here.
---

<div class:list={["buttons", align]}>
  <a href={site.appStore} rel="noopener">
    <img src="/badges/app-store.svg" alt="Télécharger dans l'App Store" width="158" height="50" />
  </a>
  <a href={site.connectIQ} rel="noopener">
    <img src="/badges/connect-iq.svg" alt="Disponible sur le Connect IQ Store, pour montre Garmin" width="146" height="50" />
  </a>
</div>

<style>
  /* Apple's minimum clear space is a quarter of the badge's height. */
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
  }

  .center {
    justify-content: center;
  }

  .buttons a {
    display: block;
    border-radius: 9px;
  }

  .buttons img {
    display: block;
    height: 50px;
    width: auto;
  }
</style>
