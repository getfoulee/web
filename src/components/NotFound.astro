---
import Notice from "./Notice.astro";
import { locales, pageLocale } from "../lib/i18n";

/* The error page in each language. Cloudflare serves the closest 404.html,
   so /en/404 answers every missing address under /en and /404 the others. */
const locale = pageLocale(Astro.currentLocale);
const copy = {
  fr: {
    title: "Page introuvable",
    heading: "Ce chemin ne mène nulle part.",
    lead: "La page que tu cherches n'existe pas, ou plus. Pas grave : fais demi-tour.",
    back: "Retour à l'accueil",
  },
  en: {
    title: "Page not found",
    heading: "This path leads nowhere.",
    lead: "The page you're looking for doesn't exist, or not anymore. No big deal: turn around.",
    back: "Back to the home page",
  },
}[locale];
---

<Notice title={copy.title} heading={copy.heading}>
  <p slot="above" class="code numeric">404</p>
  <p>{copy.lead}</p>
  <a class="back" href={locales[locale].home}>{copy.back}</a>
</Notice>

<style>
  .code {
    margin: 0;
    font-size: clamp(6rem, 20vw, 11rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .back {
    display: inline-block;
    margin-top: 24px;
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    background: var(--accent-gradient);
    color: white;
    font-weight: 600;
    text-decoration: none;
  }
</style>
