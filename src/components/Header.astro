---
import LanguageSwitch from "./LanguageSwitch.astro";
import { localePath, locales, pageLocale } from "../lib/i18n";

const locale = pageLocale(Astro.currentLocale);
const { home, anchors, appStore } = locales[locale];
const copy = {
  fr: {
    skip: "Aller au contenu",
    brand: "Foulée, accueil",
    nav: "Navigation principale",
    features: "Fonctionnalités",
    watches: "Montres",
    support: "Assistance",
    theme: "Changer de thème",
    download: "Télécharger",
  },
  en: {
    skip: "Skip to content",
    brand: "Foulée, home",
    nav: "Main navigation",
    features: "Features",
    watches: "Watches",
    support: "Support",
    theme: "Change theme",
    download: "Download",
  },
}[locale];
---

<a class="skip" href="#contenu">{copy.skip}</a>
<header class="header">
  <div class="container bar">
    <a class="brand" href={home} aria-label={copy.brand}>
      <img src="/app-icon-128.png" alt="" width="32" height="32" />
      <span>Foulée</span>
    </a>
    <nav aria-label={copy.nav}>
      <a href={`${home}#${anchors.features}`}>{copy.features}</a>
      <a href={`${home}#${anchors.watches}`}>{copy.watches}</a>
      <a href={localePath("/assistance", locale)}>{copy.support}</a>
    </nav>
    <div class="tools">
      <LanguageSwitch />
      <button class="theme-toggle" type="button" aria-label={copy.theme} title={copy.theme}>
        <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path fill="currentColor" d="M20.2 14.6A8.6 8.6 0 0 1 9.4 3.8a.6.6 0 0 0-.8-.7A9.4 9.4 0 1 0 20.9 15.4a.6.6 0 0 0-.7-.8z"></path>
        </svg>
      </button>
    </div>
    <a class="cta" href={appStore} rel="noopener">{copy.download}</a>
  </div>
</header>

<script>
  // One tap flips the theme on screen. Landing back on the device's own
  // theme forgets the choice, so the site follows the device again.
  const root = document.documentElement;
  const prefersLight = window.matchMedia("(prefers-color-scheme: light)");

  const current = () => root.dataset.theme ?? (prefersLight.matches ? "light" : "dark");

  document.querySelector(".theme-toggle")?.addEventListener("click", () => {
    const next = current() === "light" ? "dark" : "light";
    const device = prefersLight.matches ? "light" : "dark";
    try {
      if (next === device) {
        delete root.dataset.theme;
        localStorage.removeItem("theme");
      } else {
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
      }
    } catch {
      root.dataset.theme = next;
    }
  });
</script>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 12px;
    background: var(--text);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }

  .skip:focus {
    top: 12px;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top);
    background: var(--header-bg);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border-bottom: 0.5px solid var(--hairline);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand img {
    border-radius: 8px;
  }

  nav {
    display: flex;
    gap: 28px;
    margin-left: auto;
  }

  nav a {
    color: var(--text-2);
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--text);
  }

  .tools {
    display: flex;
    gap: 8px;
    margin-left: -8px;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0.5px solid var(--hairline);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text-2);
    cursor: pointer;
    transition:
      color 0.2s,
      background 0.2s;
  }

  .theme-toggle:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  /* Show what a tap switches to: the sun in dark, the moon in light. */
  .moon {
    display: none;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .sun {
      display: none;
    }

    :global(:root:not([data-theme="dark"])) .moon {
      display: block;
    }
  }

  :global(:root[data-theme="light"]) .sun {
    display: none;
  }

  :global(:root[data-theme="light"]) .moon {
    display: block;
  }

  .cta {
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    background: var(--accent-gradient);
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 18px rgb(191 90 242 / 0.35);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 26px rgb(191 90 242 / 0.5);
  }

  @media (max-width: 720px) {
    nav {
      display: none;
    }

    .bar {
      gap: 12px;
    }

    .tools {
      margin-left: auto;
    }
  }
</style>
