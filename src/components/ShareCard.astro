---
import Icon from "./Icon.astro";
import { pageLocale } from "../lib/i18n";

/* The picture a Bilan is shared as, redrawn from the app's RecapShareImage:
   the heading and period, the goal ring beside the minutes, the week's
   seven day rings, three figures, the best day, signed Foulée. Like the
   app's image, it says nothing about where or when, and carries no change
   against the week before (nothing on an image says what it compares
   with). Its background is the app's sheet gradient, in the site's theme. */

const goal = 30;
const minutes = [34, 28, 41, 31, 36, 52, 30];
const total = minutes.reduce((sum, entry) => sum + entry, 0);
const met = minutes.filter((entry) => entry >= goal).length;
const [h, m] = [Math.floor(total / 60), String(total % 60).padStart(2, "0")];

// In English, the app's own words and the en_US number formats.
const copy = {
  fr: {
    days: ["L", "M", "M", "J", "V", "S", "D"],
    hours: `${h} h ${m}`,
    label: `Un bilan de semaine à partager : ${h} h ${m} d'activité, l'objectif tenu ${met} jours sur 7, 41,2 km, 58 410 pas, 9 sorties.`,
    heading: "Ma semaine",
    period: "Du 13 au 19 octobre",
    activity: "d'activité",
    goal: `Objectif tenu ${met} jours sur 7`,
    stats: [
      ["41,2 km", "Distance"],
      ["58 410", "Pas"],
      ["9", "Sorties"],
    ],
    best: "Samedi 18 · 52 min",
  },
  en: {
    days: ["M", "T", "W", "T", "F", "S", "S"],
    hours: `${h}h ${m}m`,
    label: `A weekly recap to share: ${h}h ${m}m of activity, goal met on ${met} of 7 days, 41.2 km, 58,410 steps, 9 workouts.`,
    heading: "My week",
    period: "Oct 13 – 19",
    activity: "of activity",
    goal: `Goal met on ${met} of 7 days`,
    stats: [
      ["41.2 km", "Distance"],
      ["58,410", "Steps"],
      ["9", "Workouts"],
    ],
    best: "Saturday 18 · 52 min",
  },
}[pageLocale(Astro.currentLocale)];
const week = minutes.map((entry, index) => ({ day: copy.days[index], minutes: entry }));

const circumference = (radius: number) => 2 * Math.PI * radius;
const heroRing = circumference(34);
const dayRing = circumference(12);

const stats = (["pin", "shoe", "walk"] as const).map((icon, index) => ({ icon, value: copy.stats[index][0], label: copy.stats[index][1] }));
---

<div
  class="share-card"
  role="img"
  aria-label={copy.label}
>
  <div class="head">
    <p class="heading">{copy.heading}</p>
    <p class="period">{copy.period}</p>
  </div>

  <div class="hero">
    <svg class="ring" viewBox="0 0 84 84" aria-hidden="true">
      <defs>
        <linearGradient id="share-activity" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#5be36b"></stop>
          <stop offset="0.5" stop-color="#30d158"></stop>
          <stop offset="1" stop-color="#1fa845"></stop>
        </linearGradient>
      </defs>
      <circle class="track" cx="42" cy="42" r="34" stroke-width="10"></circle>
      <circle class="arc" cx="42" cy="42" r="34" stroke-width="10" style={`--len:${heroRing};--to:${heroRing * (1 - met / 7)}`}></circle>
      <text x="42" y="49" class="ring-label">{met}/7</text>
    </svg>
    <div>
      <p class="minutes numeric">{copy.hours}</p>
      <p class="sub">{copy.activity}</p>
      <p class="goal-line">{copy.goal}</p>
    </div>
  </div>

  <div class="days" aria-hidden="true">
    {
      week.map((entry, index) => (
        <div class="day">
          <svg viewBox="0 0 32 32">
            <circle class="track" cx="16" cy="16" r="12" stroke-width="4.5" />
            {entry.minutes >= goal && <circle class="met" cx="16" cy="16" r="6.5" />}
            <circle
              class="arc"
              cx="16"
              cy="16"
              r="12"
              stroke-width="4.5"
              style={`--len:${dayRing};--to:${dayRing * (1 - Math.min(entry.minutes / goal, 1))};--i:${index}`}
            />
          </svg>
          <span>{entry.day}</span>
        </div>
      ))
    }
  </div>

  <div class="stats">
    {
      stats.map((stat) => (
        <div class="stat">
          <Icon name={stat.icon} size={14} />
          <b class="numeric">{stat.value}</b>
          <span>{stat.label}</span>
        </div>
      ))
    }
  </div>

  <p class="best"><span aria-hidden="true">🏆</span> {copy.best}</p>

  <p class="signature">
    <Icon name="walk" size={16} />
    Foulée
  </p>
</div>

<style>
  .share-card {
    --share-bg: linear-gradient(135deg, #1a0a3a, #350a30 50%, #0a0a20);
    --share-tile: rgb(255 255 255 / 0.08);
    --share-track: rgb(142 142 147 / 0.25);

    display: flex;
    flex-direction: column;
    gap: 16px;
    width: min(360px, 100%);
    aspect-ratio: 4 / 5;
    padding: 24px;
    border-radius: 32px;
    background: var(--share-bg);
    border: 0.5px solid var(--glass-border);
    box-shadow:
      0 40px 80px -24px rgb(40 10 80 / 0.45),
      0 0 80px rgb(191 90 242 / 0.2);
    color: var(--text);
    transform: rotateY(-10deg) rotateX(4deg);
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .share-card {
      --share-bg: linear-gradient(135deg, #f7d6ff, #ffe6f3 50%, #d6e4ff);
      --share-tile: rgb(255 255 255 / 0.6);
      --share-track: rgb(142 142 147 / 0.18);
    }
  }

  :global(:root[data-theme="light"]) .share-card {
    --share-bg: linear-gradient(135deg, #f7d6ff, #ffe6f3 50%, #d6e4ff);
    --share-tile: rgb(255 255 255 / 0.6);
    --share-track: rgb(142 142 147 / 0.18);
  }

  .share-card:hover {
    transform: rotateY(0) rotateX(0);
  }

  p {
    margin: 0;
  }

  .heading {
    font-family: var(--font-rounded);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .period,
  .sub,
  .day span,
  .stat span {
    color: var(--text-2);
  }

  .period {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .hero {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .ring {
    flex: none;
    width: 84px;
    height: 84px;
  }

  .track {
    fill: none;
    stroke: var(--share-track);
  }

  .arc {
    fill: none;
    stroke: url(#share-activity);
    stroke-linecap: round;
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--to);
    transform: rotate(-90deg);
    transform-box: fill-box;
    transform-origin: center;
  }

  .days .arc {
    stroke: #30d158;
  }

  :global(.js) .share-card .arc {
    stroke-dashoffset: var(--len);
    transition: stroke-dashoffset 1.1s cubic-bezier(0.3, 0.7, 0.2, 1);
    transition-delay: calc(0.3s + var(--i, 0) * 0.08s);
  }

  :global(.is-visible) .share-card .arc {
    stroke-dashoffset: var(--to);
  }

  .ring-label {
    fill: var(--text);
    font: 700 19px var(--font-rounded);
    text-anchor: middle;
  }

  .minutes {
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .sub {
    margin-top: 4px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .goal-line {
    margin-top: 4px;
    color: var(--minutes);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
  }

  .day {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }

  .day svg {
    width: 32px;
    height: 32px;
  }

  .met {
    fill: rgb(48 209 88 / 0.16);
  }

  .day span {
    font-size: 0.7rem;
    font-weight: 600;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px;
    border-radius: 14px;
    background: var(--share-tile);
  }

  .stat :global(svg) {
    color: var(--accent-mid);
  }

  .stat b {
    font-size: 1rem;
    line-height: 1.1;
  }

  .stat span {
    font-size: 0.7rem;
    font-weight: 500;
  }

  .best {
    color: var(--calories);
    font-family: var(--font-rounded);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .signature {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    margin-top: auto;
    font-family: var(--font-rounded);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .signature :global(svg) {
    color: var(--accent-mid);
  }
</style>
