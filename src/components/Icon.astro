---
/** A handful of SF Symbol look-alikes, drawn on a 24-point grid. */
interface Props {
  name: "shoe" | "timer" | "pin" | "flame" | "drop" | "play" | "heart" | "walk" | "run" | "lock" | "server" | "health" | "bell" | "sparkles" | "watch" | "chart" | "check" | "map" | "widgets" | "merge";
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {name === "shoe" && <path d="M3 16.5V9.2c0-.7.6-1.2 1.3-1l2.2.6 1.4-2.3c.3-.5 1-.6 1.4-.2l1.4 1.2c1 .9 2.2 1.6 3.5 2l3.8 1.2c1.8.6 3 2.2 3 4.1v1.7c0 .6-.4 1-1 1H4c-.6 0-1-.4-1-1z M3 14h18" />}
  {name === "timer" && <><circle cx="12" cy="13.5" r="7.5" /><path d="M12 13.5V9.5M9.5 2.5h5M18.5 6.5l1.5-1.5" /></>}
  {name === "pin" && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === "flame" && <path fill="currentColor" stroke="none" d="M12.6 2.3c.3 2.9-1 4.6-2.4 6.3C8.7 10.4 7 12.4 7 15.3 7 18.7 9.3 21.5 12.3 21.5c3.3 0 5.7-2.6 5.7-6.1 0-2.6-1.2-4.6-2.4-6.1-.2 1.4-.8 2.4-1.8 3 .3-3.4-.6-7-1.2-10z" />}
  {name === "drop" && <path fill="currentColor" stroke="none" d="M12 2.8s-6.3 7.1-6.3 11.6a6.3 6.3 0 0 0 12.6 0C18.3 9.9 12 2.8 12 2.8z" />}
  {name === "play" && <path fill="currentColor" stroke="none" d="M7 4.8v14.4c0 .8.9 1.3 1.6.8l11-7.2c.6-.4.6-1.2 0-1.6l-11-7.2C7.9 3.5 7 4 7 4.8z" />}
  {name === "heart" && <path fill="currentColor" stroke="none" d="M12 20.7S3 15.3 3 9.1A4.6 4.6 0 0 1 12 7.4a4.6 4.6 0 0 1 9 1.7c0 6.2-9 11.6-9 11.6z" />}
  {name === "walk" && <><circle cx="13" cy="4" r="1.8" fill="currentColor" stroke="none" /><path d="M10.5 21l2-5.5-2.5-2.5 1-5 3 3h3M8 11l2-3.5M13 15.5l3 5.5" /></>}
  {name === "run" && <><circle cx="15" cy="4" r="1.8" fill="currentColor" stroke="none" /><path d="M5 21l4-4.5 2.5 1L13 13l-3-2.5 3.5-3 2.5 3h3.5M10 10.5l-3 1.5M13 13l3.5 3-1.5 5" /></>}
  {name === "lock" && <><rect x="5" y="10.5" width="14" height="10" rx="2.5" /><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" /></>}
  {name === "server" && <><rect x="4" y="3.5" width="16" height="7" rx="2" /><rect x="4" y="13.5" width="16" height="7" rx="2" /><path d="M8 7h.01M8 17h.01M3 21L21 3" /></>}
  {name === "health" && <path fill="currentColor" stroke="none" d="M12 21s-8.5-5.1-8.5-11.2A4.8 4.8 0 0 1 12 7a4.8 4.8 0 0 1 8.5 2.8C20.5 15.9 12 21 12 21z" />}
  {name === "bell" && <path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.5 2H4.5zM10 21h4" />}
  {name === "sparkles" && <path fill="currentColor" stroke="none" d="M10 3l1.6 4.9L16.5 9.5l-4.9 1.6L10 16l-1.6-4.9L3.5 9.5l4.9-1.6zM18 13l.9 2.6 2.6.9-2.6.9L18 20l-.9-2.6-2.6-.9 2.6-.9z" />}
  {name === "watch" && <><rect x="6" y="6" width="12" height="12" rx="3.5" /><path d="M9 6l.6-3h4.8L15 6M9 18l.6 3h4.8l.6-3" /></>}
  {name === "chart" && <path d="M5 20V12M10 20V6M15 20v-9M20 20V9" />}
  {name === "check" && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {name === "widgets" && <><rect x="3.5" y="3.5" width="7.5" height="7.5" rx="2" /><rect x="13" y="3.5" width="7.5" height="7.5" rx="2" /><rect x="3.5" y="13" width="17" height="7.5" rx="2" /></>}
  {name === "merge" && <path d="M6 3.5v4.5c0 2.5 1.5 4 4 5.2L12 14l2-0.8c2.5-1.2 4-2.7 4-5.2V3.5M12 14v6.5M9.5 18l2.5 2.5 2.5-2.5" />}
  {name === "map" && <path d="M3.5 6.5l5.5-2.5 6 2.5 5.5-2.5v13.5L15 20l-6-2.5-5.5 2.5zM9 4v13.5M15 6.5V20" />}
</svg>
