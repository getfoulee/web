{
  "name": "foulee-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "assets": "node scripts/generate-assets.mjs",
    "screenshots": "node scripts/fetch-screenshots.mjs",
    "check": "astro check",
    "test": "node scripts/check-site.mjs",
    "links": "node scripts/check-links.mjs",
    "lighthouse": "npm run lighthouse:mobile && npm run lighthouse:desktop",
    "lighthouse:mobile": "lhci autorun",
    "lighthouse:desktop": "lhci autorun --collect.settings.preset=desktop --upload.outputDir=.lighthouseci/desktop",
    "test:a11y": "playwright test a11y",
    "test:visual": "playwright test visual"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "sharp": "0.34.5",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  }
}
